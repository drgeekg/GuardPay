# Copy this file to .env and fill in your real keys.
# Never commit .env to version control — it is gitignored.

# Razorpay test-mode credentials
# Get these from https://dashboard.razorpay.com/app/keys (test mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Anthropic Claude API key (used for incident dossier generation only)
# Get from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-YOUR_KEY

# Backend config (defaults shown — override as needed)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Velocity engine thresholds (tune per merchant)
# Max transactions per card per minute before flagging
VELOCITY_TXN_PER_CARD_PER_MIN=10
# Max unique cards from same BIN in rolling window before flagging
VELOCITY_BIN_CLUSTER_THRESHOLD=5
# Max unique cards from same /24 subnet in rolling window before flagging
VELOCITY_SUBNET_CLUSTER_THRESHOLD=8
# Rolling window in seconds
VELOCITY_WINDOW_SECONDS=60
