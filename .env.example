# Copy this file to .env and fill in your real keys.
# Never commit .env to version control — it is gitignored.

# ---------------------------------------------------------------------------
# Razorpay test-mode credentials
# Get these from https://dashboard.razorpay.com/app/keys (test mode)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ---------------------------------------------------------------------------
# LLM Provider 1: Anthropic Claude (Incident dossier generation)
# Get from https://console.anthropic.com/
# ---------------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-YOUR_KEY
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# LLM Provider 2: NVIDIA NIM (OpenAI-compatible cloud LLM inference)
# Get a free API key from https://build.nvidia.com/
# Recommended models:
#   - meta/llama-3.1-8b-instruct (Fast)
#   - meta/llama-3.3-70b-instruct
#   - nvidia/llama-3.1-nemotron-70b-instruct
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-YOUR_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ---------------------------------------------------------------------------
# LLM Provider 3: Cloud Ollama / Remote LLM (with API Key & Custom URL)
# Use for hosted Ollama, OpenWebUI, RunPod, vLLM, Modal, or Groq
# ---------------------------------------------------------------------------
OLLAMA_CLOUD_BASE_URL=https://your-cloud-ollama-instance.com
OLLAMA_CLOUD_API_KEY=your_cloud_api_key_or_bearer_token
OLLAMA_CLOUD_MODEL=llama3

# ---------------------------------------------------------------------------
# LLM Provider 4: Local Ollama (localhost without auth)
# Leave pointing to localhost if running Ollama locally
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Backend server config
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Velocity engine thresholds (tune per merchant)
# ---------------------------------------------------------------------------
VELOCITY_TXN_PER_CARD_PER_MIN=10
VELOCITY_BIN_CLUSTER_THRESHOLD=5
VELOCITY_SUBNET_CLUSTER_THRESHOLD=8
VELOCITY_WINDOW_SECONDS=60
